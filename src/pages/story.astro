---
import Layout from '../components/Layout.astro';
import { isHQ } from '../buildMode';
import { skryvatVeVerejnem } from '../data/sekce';
if (!isHQ && skryvatVeVerejnem(Astro.url.pathname)) return Astro.redirect('/');
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import content from '../data/content.json';

const uvod = [
  { label: 'PROČ TO VZNIKLO',   text: content.story.origin },
  { label: 'MOMENT ROZHODNUTÍ', text: content.story.moment },
  { label: 'CO SLIBUJEME',      text: content.story.promise },
];
---
<Layout title="Brand Story">
  <SectionTitle
    title="Origin"
    subtitle="Jak vzniklo eldee — z frustrace, designu a českého řemesla."
  />

  <!-- Tři díly jednoho vyprávění, ne tři pásy: proto zůstávají u sebe
       ve čtecí šířce a dělí je jen štítek. -->
  <div class="space-y-11 max-w-2xl">
    {uvod.map((u) => (
      <section>
        <div class="font-mono text-caption text-gold mb-3">{u.label}</div>
        <p class="text-body-lg text-bone/85">{u.text}</p>
      </section>
    ))}
  </div>

  <PasHlavicka nazev="Timeline" hlas linka />
  <!-- Mřížka místo flexu s min-width: na telefonu se datum postaví nad
       událost, takže text neztenčí na dvě slova na řádek. -->
  <ol>
    {content.story.milestones.map((m) => (
      <li class="grid sm:grid-cols-[7rem_1fr] gap-y-1 sm:gap-x-8 py-5 border-t border-bone/12 first:border-t-0">
        <div class="font-mono text-caption text-blood">{m.date}</div>
        <div class="text-body-lg text-bone/85">{m.event}</div>
      </li>
    ))}
  </ol>

</Layout>
