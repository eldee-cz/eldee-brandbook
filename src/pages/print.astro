---
import Layout from '../components/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Ukazka from '../components/Ukazka.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Pravidla from '../components/Pravidla.astro';
import Pravidlo from '../components/Pravidlo.astro';
import Zakaz from '../components/Zakaz.astro';

// Velikosti uvnitř ukázek jsou v `cqw` = procento šířky rámečku. Viz Ukazka.astro.
---
<Layout title="Tiskoviny">
  <SectionTitle
    title="Tiskoviny"
    subtitle="Vizitka, krabička, hangtag, samolepky. Fyzické projevy značky — každý s rozměrem, materiálem a pravidly."
  />

  <!-- ── Vizitka ────────────────────────────────────────────────────────── -->
  <!-- Varianta K1 „červené jádro“ — rozhodnuto při revizi 18. 9. 2026
       (eldee-business/brand/revize-v3/vizitka-varianty/vizitka-kolo-4.html). -->
  <PasHlavicka nazev="Vizitka" meta={['85 × 55 mm', 'triplex 700 g · černá–červená–černá']} prvni />

  <div class="grid sm:grid-cols-2 gap-4">
    <Ukazka format="vizitka" plocha="ink" popis="Přední strana">
      <img src="/logo/wordmark-light.svg" alt="Logo eldee" class="m-auto w-[54cqw] h-auto" />
    </Ukazka>

    <Ukazka format="vizitka" plocha="ink" popis="Zadní strana">
      <div class="flex justify-between items-start gap-[4cqw]">
        <div>
          <div class="w-[12cqw] h-[1cqw] bg-blood mb-[3cqw]"></div>
          <div class="font-display text-[6.4cqw] text-bone leading-none uppercase">Lukáš Hledík</div>
          <div class="font-mono text-[2.5cqw] tracking-[0.2em] uppercase text-bone/60 mt-[1.8cqw]">CEO</div>
        </div>
        <div class="relative shrink-0 w-[23cqw] h-[23cqw] bg-bone rounded-[0.6cqw]" role="img" aria-label="QR kód">
          <span class="absolute left-[2cqw] top-[2cqw] w-[5.6cqw] h-[5.6cqw] border-[1.3cqw] border-ink"></span>
          <span class="absolute right-[2cqw] top-[2cqw] w-[5.6cqw] h-[5.6cqw] border-[1.3cqw] border-ink"></span>
          <span class="absolute left-[2cqw] bottom-[2cqw] w-[5.6cqw] h-[5.6cqw] border-[1.3cqw] border-ink"></span>
        </div>
      </div>
      <div class="flex justify-between items-end gap-[4cqw]">
        <div class="font-mono text-[2.6cqw] leading-[1.75] text-bone/80">
          <div>lukas@eldee.cz</div>
          <div>+420 777 123 456</div>
          <div>eldeeworld.com · @eldee.cz</div>
        </div>
        <img src="/logo/monogram-ld.svg" alt="Monogram LD" class="w-[13cqw] h-auto shrink-0" />
      </div>
    </Ukazka>
  </div>

  <figure class="mt-4 max-w-md" data-ukazka>
    <div class="h-3 border border-bone/10" style="background:linear-gradient(to bottom,#161616 0 34%,#B91C1C 34% 66%,#050505 66% 100%)"></div>
    <figcaption class="font-mono text-caption text-bone/45 mt-2.5">Hrana karty — červené jádro (tloušťka zvětšená)</figcaption>
  </figure>

  <Pravidla>
    <Pravidlo typ="ok">Červená je jen v jádru kartonu. Uvidí ji ten, kdo kartu drží — ne ten, kdo se na ni dívá.</Pravidlo>
    <Pravidlo typ="ok">QR vpravo nahoře, vždy tmavý na světlém poli. Tak ho přečte každý telefon.</Pravidlo>
    <Pravidlo typ="rozmer">85 × 55 mm, triplex 700 g černá–červená–černá. Logo bílou ražbou fólií, svatozář zlatá — tiskem nebo ražbou podle dodavatele.</Pravidlo>
  </Pravidla>

  <!-- ── Krabička ───────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Krabička" meta={['18 × 12 × 5 cm', 'matná černá · zlatá svatozář']} />

  <div class="grid lg:grid-cols-[1.5fr_1fr] gap-4 items-start">
    <div class="space-y-4 min-w-0">
      <Ukazka format="krabice" plocha="ink" popis="Víko krabičky">
        <img src="/logo/wordmark-light.svg" alt="Logo eldee" class="w-[36cqw] h-auto" />
        <div class="font-brush text-gold text-[7cqw] -rotate-3 mt-[2cqw]">holy socks.</div>
      </Ukazka>
      <Ukazka format="bok" plocha="ink" popis="Bok krabičky">
        <div class="font-mono text-[2.4cqw] tracking-[0.18em] uppercase text-bone/60">Drop 001 · XS · S · M · L</div>
      </Ukazka>
    </div>

    <Ukazka format="ctverec" plocha="podklad" popis="Vnitřek">
      <div class="font-mono text-[3.4cqw] tracking-[0.18em] uppercase text-gold mb-[5cqw]">Uvnitř</div>
      <div class="font-display italic text-[9cqw] text-bone leading-tight">Hedvábný papír<br/>+ UGC karta</div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Wordmark na víku vždy vodorovně a na střed. Svatozář nad ním být nesmí.</Pravidlo>
    <Pravidlo typ="ok">Velikosti na boku krabičky: XS · S · M · L. Žádné číselné rozpětí EU.</Pravidlo>
    <Pravidlo typ="rozmer">18 × 12 × 5 cm, matná černá. Písmena bílá, svatozář zlatá — tiskem nebo ražbou podle dodavatele, nikdy ne ze čtyř tiskových barev.</Pravidlo>
  </Pravidla>

  <!-- ── Hangtag ────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Hangtag" meta={['5 × 8 cm', 'kraft 300 g']} />

  <div class="grid grid-cols-2 gap-4 max-w-[460px]">
    <Ukazka format="hangtag" plocha="kraft" popis="Přední strana">
      <span class="w-[6cqw] h-[6cqw] rounded-full bg-ink/80" aria-hidden="true"></span>
      <img src="/logo/monogram-mono-dark.svg" alt="Monogram LD" class="w-[30cqw] h-auto" />
      <div>
        <div class="font-display italic text-[15cqw] text-ink leading-none">DROP 001</div>
        <div class="font-mono text-[4.5cqw] tracking-[0.15em] uppercase text-ink mt-[2cqw]">Holy Socks</div>
      </div>
      <div class="relative w-[28cqw] h-[28cqw] bg-bone rounded-[1.5cqw]" role="img" aria-label="QR kód">
        <span class="absolute left-[2.6cqw] top-[2.6cqw] w-[7cqw] h-[7cqw] border-[1.6cqw] border-ink"></span>
        <span class="absolute right-[2.6cqw] top-[2.6cqw] w-[7cqw] h-[7cqw] border-[1.6cqw] border-ink"></span>
        <span class="absolute left-[2.6cqw] bottom-[2.6cqw] w-[7cqw] h-[7cqw] border-[1.6cqw] border-ink"></span>
      </div>
    </Ukazka>

    <Ukazka format="hangtag" plocha="kraft" popis="Zadní strana">
      <span class="w-[6cqw] h-[6cqw] rounded-full bg-ink/80" aria-hidden="true"></span>
      <div>
        <div class="font-mono text-[3.6cqw] tracking-[0.18em] uppercase text-ink">Velikost</div>
        <div class="font-display italic text-[30cqw] text-ink leading-none mt-[1cqw]">M</div>
      </div>
      <div class="w-full font-mono text-[3.4cqw] text-ink text-left">
        <div class="flex justify-between gap-[2cqw] border-t border-ink/25 py-[2.2cqw]"><span class="uppercase tracking-[0.14em]">Složení</span><span>doplní výrobce</span></div>
        <div class="flex justify-between gap-[2cqw] border-y border-ink/25 py-[2.2cqw]"><span class="uppercase tracking-[0.14em]">Péče</span><span>symboly</span></div>
      </div>
      <div class="font-mono text-[3.2cqw] tracking-[0.12em] uppercase text-ink">Vyrobeno v ČR · eldeeworld.com</div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">QR kód vede na stránku konkrétního dropu, ne na domovskou stránku.</Pravidlo>
    <Pravidlo typ="ne">Křídový papír a zlatá na kraftu. Kraft je součást hmatového dojmu — a zlatá na něm (kontrast 1,1 : 1) zmizí, proto je logo celé tmavé, i svatozář.</Pravidlo>
    <Pravidlo typ="rozmer">5 × 8 cm, kraft 300 g, otvor 5 mm od horní hrany. Vzadu velikost, složení a péče; přesné znění dodá výrobce.</Pravidlo>
  </Pravidla>

  <!-- ── Samolepky ──────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Samolepky" meta={['3 designy × 100 ks', 'zdarma v každé krabičce']} />

  <Zakaz>Samolepka se nikdy nelepí na produkt ani na krabičku zvenku. Je to dárek, ne etiketa.</Zakaz>

  <div class="grid sm:grid-cols-3 gap-4">
    <Ukazka format="ctverec" plocha="podklad" popis="LD monogram">
      <div class="w-[46cqw] h-[46cqw] bg-blood rounded-full flex items-center justify-center">
        <img src="/logo/monogram-ld.svg" alt="Monogram LD" class="w-[30cqw] h-auto" />
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="podklad" popis="Wordmark">
      <div class="w-[66cqw] h-[22cqw] bg-ink flex items-center justify-center">
        <img src="/logo/wordmark-light.svg" alt="Logo eldee" class="h-[16cqw] w-auto" />
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="podklad" popis="Brush">
      <div class="w-[62cqw] h-[22cqw] bg-gold flex items-center justify-center -rotate-3">
        <span class="font-brush text-[13cqw] text-ink leading-none">holy socks.</span>
      </div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Tři designy v každém balení. Nikdy jen jeden — sbírka je součást zážitku.</Pravidlo>
    <Pravidlo typ="ok">Brush varianta se sází nakřivo. Rovně vypadá jako cenovka.</Pravidlo>
    <Pravidlo typ="rozmer">Monogram ⌀ 5 cm · wordmark 7 × 2,5 cm · brush 7 × 2,5 cm.</Pravidlo>
  </Pravidla>

</Layout>
