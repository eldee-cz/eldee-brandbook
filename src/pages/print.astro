---
import Layout from '../components/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Ukazka from '../components/Ukazka.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Pravidla from '../components/Pravidla.astro';
import Pravidlo from '../components/Pravidlo.astro';
import Zakaz from '../components/Zakaz.astro';

// Velikosti uvnitř ukázek jsou v `cqw` = procento šířky rámečku. Viz Ukazka.astro.
---
<Layout title="Tiskoviny">
  <SectionTitle
    title="Tiskoviny"
    subtitle="Vizitka, krabička, hangtag, samolepky. Fyzické projevy značky — každý s rozměrem, materiálem a pravidly."
  />

  <!-- ── Vizitka ────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Vizitka" meta={['85 × 55 mm', 'matte black 350 g']} prvni />

  <div class="grid sm:grid-cols-2 gap-4">
    <Ukazka format="vizitka" plocha="ink" popis="Přední strana">
      <div class="flex items-center justify-between gap-[6cqw]">
        <span class="font-display italic text-[9cqw] text-bone leading-none">eldee</span>
        <span class="flex gap-[2.2cqw]">
          <span class="w-[4cqw] h-[6.5cqw] rounded-full bg-black border border-bone/70 shadow-[inset_0_1px_2px_rgba(0,0,0,0.9)]"></span>
          <span class="w-[4cqw] h-[6.5cqw] rounded-full bg-black border border-bone/70 shadow-[inset_0_1px_2px_rgba(0,0,0,0.9)]"></span>
        </span>
      </div>
      <div>
        <div class="font-mono text-[2.6cqw] tracking-[0.18em] uppercase text-gold mb-[1cqw]">CEO</div>
        <div class="font-display italic text-[7cqw] text-bone leading-none">LUKÁŠ HLEDÍK</div>
      </div>
    </Ukazka>

    <Ukazka format="vizitka" plocha="ink" popis="Zadní strana">
      <div class="m-auto text-center space-y-[1.6cqw]">
        <div class="font-mono text-[2.8cqw] tracking-[0.15em] text-bone/80">lukas@eldee.cz</div>
        <div class="font-mono text-[2.8cqw] tracking-[0.15em] text-bone/80">+420 ...</div>
        <div class="font-mono text-[2.8cqw] tracking-[0.15em] text-bone/80">eldeeworld.com · @eldee.cz</div>
        <div class="font-display italic text-[7cqw] text-gold leading-none pt-[1cqw]">LD</div>
      </div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Oválné díry jsou vyseknuté skrz papír, ne natištěné. Karta je ukázka produktu.</Pravidlo>
    <Pravidlo typ="ne">Zlatá ražba na běžné edici. Gold foil patří jen na premium.</Pravidlo>
    <Pravidlo typ="rozmer">85 × 55 mm, matný černý karton 350 g.</Pravidlo>
  </Pravidla>

  <!-- ── Krabička ───────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Krabička" meta={['18 × 12 × 5 cm', 'matte black + gold foil']} />

  <div class="grid lg:grid-cols-[1.5fr_1fr] gap-4 items-start">
    <Ukazka format="krabice" plocha="ink" popis="Víko krabičky">
      <div class="w-[26cqw] h-[4cqw] border-2 border-gold rounded-full mb-[4cqw]"></div>
      <div class="font-display italic text-[13cqw] text-bone leading-none">eldee</div>
      <div class="font-brush text-gold text-[7cqw] -rotate-3 mt-[2cqw]">holy socks.</div>
      <div class="font-mono text-[2.8cqw] tracking-[0.18em] uppercase text-bone/60 mt-[5cqw]">Drop 001 · XS · M · L</div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="podklad" popis="Vnitřek">
      <div class="font-mono text-[3.4cqw] tracking-[0.18em] uppercase text-gold mb-[5cqw]">Uvnitř</div>
      <div class="font-display italic text-[9cqw] text-bone leading-tight">Hedvábný papír<br/>+ UGC karta</div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Wordmark na víku vždy vodorovně a na střed. Svatozář nad ním být nesmí.</Pravidlo>
    <Pravidlo typ="ok">Velikosti na boku krabičky: XS · M · L. Žádné číselné rozpětí EU.</Pravidlo>
    <Pravidlo typ="rozmer">18 × 12 × 5 cm, matná černá, zlatá ražba na wordmarku.</Pravidlo>
  </Pravidla>

  <!-- ── Hangtag ────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Hangtag" meta={['5 × 8 cm', 'kraft 300 g']} />

  <div class="max-w-[220px]">
    <Ukazka format="hangtag" plocha="bone" popis="Přední strana">
      <div class="font-display italic text-[16cqw] text-gold leading-none">LD</div>
      <div>
        <div class="font-display italic text-[13cqw] text-ink leading-none">DROP 001</div>
        <div class="font-mono text-[4.5cqw] tracking-[0.15em] uppercase text-blood mt-[2cqw]">Holy Socks</div>
      </div>
      <div class="w-[26cqw] h-[26cqw] bg-ink grid grid-cols-3 gap-px p-[1.5cqw]">
        {Array.from({ length: 9 }).map(() => <div class="bg-bone"></div>)}
      </div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">QR kód vede na stránku konkrétního dropu, ne na domovskou stránku.</Pravidlo>
    <Pravidlo typ="ne">Tisknout hangtag na křídový papír. Kraft je součást hmatového dojmu.</Pravidlo>
    <Pravidlo typ="rozmer">5 × 8 cm, kraft 300 g, otvor 5 mm od horní hrany.</Pravidlo>
  </Pravidla>

  <!-- ── Samolepky ──────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Samolepky" meta={['3 designy × 100 ks', 'zdarma v každé krabičce']} />

  <Zakaz>Samolepka se nikdy nelepí na produkt ani na krabičku zvenku. Je to dárek, ne etiketa.</Zakaz>

  <div class="grid sm:grid-cols-3 gap-4">
    <Ukazka format="ctverec" plocha="podklad" popis="LD monogram">
      <div class="w-[46cqw] h-[46cqw] bg-blood rounded-full flex items-center justify-center">
        <span class="font-display italic text-[20cqw] text-ink leading-none">LD</span>
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="podklad" popis="Wordmark">
      <div class="w-[66cqw] h-[22cqw] bg-ink flex items-center justify-center">
        <span class="font-display italic text-[14cqw] text-bone leading-none">eldee</span>
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="podklad" popis="Brush">
      <div class="w-[62cqw] h-[22cqw] bg-gold flex items-center justify-center -rotate-3">
        <span class="font-brush text-[13cqw] text-ink leading-none">holy socks.</span>
      </div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Tři designy v každém balení. Nikdy jen jeden — sbírka je součást zážitku.</Pravidlo>
    <Pravidlo typ="ok">Brush varianta se sází nakřivo. Rovně vypadá jako cenovka.</Pravidlo>
    <Pravidlo typ="rozmer">Monogram ⌀ 5 cm · wordmark 7 × 2,5 cm · brush 7 × 2,5 cm.</Pravidlo>
  </Pravidla>

</Layout>
