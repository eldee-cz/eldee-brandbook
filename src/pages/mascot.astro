---
import Layout from '../components/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Pravidla from '../components/Pravidla.astro';
import Pravidlo from '../components/Pravidlo.astro';
import AssetDownload from '../components/AssetDownload.astro';

// Rozvržení B2: ukázka vede, pravidla v kartách pod ní.
//
// Obsahově se sloučila „Kanonická podoba“ s „Do / Don't“. Říkaly totéž
// dvakrát jinými slovy — seznam „žíhání tmavě hnědé (espresso), ⚠️ NE zrzavé“
// a o dvě obrazovky níž „✗ žíhání zrzavé / rezavé / béžové“. Kdo četl jen
// jedno z toho, měl polovinu pravidla.
const pozy = [
  {
    src: '/mascot/eldee-prodejce.png',
    name: 'Svatý prodejce',
    tag: 'Hlavní',
    use: 'Otevírá krabičku se štulpnami — „tady to máš“. Hero na webu, úvodní vizuál, balení.',
  },
  {
    src: '/mascot/eldee-fotbalista.png',
    name: 'Fotbalista',
    tag: 'Komunita',
    use: 'Eldee v celém kitu značky. Komunitní obsah, Holy Squad, fotbalová témata.',
  },
  {
    src: '/mascot/eldee-srdicko.png',
    name: 'Srdíčko',
    tag: 'Poděkování',
    use: 'Tlapy spojené v srdce z drápů. Děkovačka po objednávce, díky komunitě.',
  },
];

const paleta = [
  { name: 'Off-white', hex: '#F5F5F0', note: 'světlá srst — břicho, obličej' },
  { name: 'Espresso', hex: '#5A3A2A', note: 'žíhání srsti' },
  { name: 'Carbon Black', hex: '#0A0A0A', note: 'brýle, krabička, lemy' },
  { name: 'Burnished Gold', hex: '#C9A227', note: 'svatozář, logo LD' },
  { name: 'Blood Red', hex: '#B91C1C', note: 'linka a lem děr' },
];
---
<Layout title="Maskot" description="Eldee — maskot značky eldee. Kdo to je, jak přesně vypadá a jak ho používat.">
  <SectionTitle
    title="Eldee"
    subtitle="Lenochod se svatozáří, co ti otevírá krabičku. Jmenuje se stejně jako značka — protože maskot je značka."
  />

  <!-- ── Hero ───────────────────────────────────────────────────────────── -->
  <div class="rounded-lg overflow-hidden border border-bone/10 bg-ink">
    <div class="aspect-[16/9] flex items-center justify-center p-8" style="background:radial-gradient(circle at 50% 45%, rgba(201,162,39,0.18), #0A0A0A 70%)">
      <img src="/mascot/eldee-prodejce.png" alt="Eldee — maskot značky eldee, svatý prodejce" class="max-h-full max-w-full" />
    </div>
  </div>

  <p class="text-body-lg text-bone/70 mt-6 max-w-2xl">
    Příběh sedí na claim <strong class="text-bone">„Holy Socks.“</strong> — štulpny mají díry, tak jsou
    z nich svaté ponožky, a Eldee k nim dostal svatozář. Je to lenochod: pohodový, drzý, ale milý.
    Jede si svoje, nikam nespěchá, ale ví, co má.
  </p>

  <!-- ── Povaha ─────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Kdo je Eldee" meta={['Archetyp · lenochod', 'Jméno = značka']} />

  <div class="grid md:grid-cols-3 gap-4">
    <div class="border border-bone/10 rounded-lg p-5">
      <div class="font-mono text-caption text-gold mb-2">Povaha</div>
      <p class="text-body text-bone/85">Chill, sebevědomý, sympatický. Drzý, ale nikdy agresivní. Jede si svoje, ale ví, co má.</p>
    </div>
    <div class="border border-bone/10 rounded-lg p-5">
      <div class="font-mono text-caption text-gold mb-2">Jméno je značka</div>
      <p class="text-body text-bone/85">Maskot se jmenuje Eldee — stejně jako značka. Každé jeho použití zapisuje název do hlavy. V komunikaci ho říkej nahlas: „Tohle je Eldee.“</p>
    </div>
    <div class="border border-bone/10 rounded-lg p-5">
      <div class="font-mono text-caption text-gold mb-2">Pohyb ve videu</div>
      <p class="text-body text-bone/85">Pomalý, líný, úsporný v gestech — je to lenochod. Kývnutí, líné mávnutí, spokojený úsměv. Nic hektického.</p>
    </div>
  </div>

  <!-- ── Pózy ───────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Pózy" meta={['Veřejné · 3', 'Sezónní · tajná drop série']} />

  <div class="grid md:grid-cols-3 gap-4">
    {pozy.map((p) => (
      <div class="rounded-lg overflow-hidden border border-bone/10">
        <div class="aspect-square flex items-center justify-center p-8 bg-ink relative">
          <span class="absolute top-3 left-3 font-mono text-[9.5px] tracking-[0.18em] uppercase text-gold">{p.tag}</span>
          <img src={p.src} alt={`Eldee — ${p.name}`} class="max-h-full max-w-full" />
        </div>
        <div class="p-4">
          <div class="font-display text-h3 text-bone mb-1">{p.name}</div>
          <p class="text-body text-bone/70">{p.use}</p>
        </div>
      </div>
    ))}
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Pořád ten samý lenochod, jen v jiné situaci. Nová póza není nová postava.</Pravidlo>
    <Pravidlo typ="ok">Když má Eldee pokrývku hlavy, svatozář je nad ní — nikdy přes ni.</Pravidlo>
    <Pravidlo typ="ne">Vytvářet vlastní pózu bez referenčního obrázku. Vždycky vznikne někdo jiný.</Pravidlo>
  </Pravidla>

  <!-- ── Kanonická podoba ───────────────────────────────────────────────── -->
  <PasHlavicka nazev="Jak musí vypadat" meta={['Závazné', 'Platí na web, merch i AI video']} />

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    Popis odshora dolů. Tohle jsou kotvy, podle kterých se pozná, že je to pořád Eldee —
    a ne lenochod, který se mu podobá.
  </p>

  <div class="grid md:grid-cols-2 gap-4">
    <div class="rounded-lg overflow-hidden border border-bone/10">
      <div class="aspect-square flex items-center justify-center p-8 bg-ink">
        <img src="/mascot/eldee-prodejce.png" alt="Eldee — kanonická podoba" class="max-h-full max-w-full" />
      </div>
      <div class="p-4 font-mono text-caption text-bone/45">Kanonická podoba — podle téhle se generuje všechno ostatní</div>
    </div>
    <div class="rounded-lg overflow-hidden border border-bone/10">
      <div class="aspect-square flex items-center justify-center p-8 bg-ink">
        <img src="/mascot/eldee-fotbalista.png" alt="Eldee ve štulpnách eldee" class="max-h-full max-w-full" />
      </div>
      <div class="p-4 font-mono text-caption text-bone/45">Štulpny jsou vždycky eldee — logo LD, červená linka, tři půlměsícové díry</div>
    </div>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Svatozář je zlatý plochý prstenec — vodorovná dutá elipsa nad hlavou.</Pravidlo>
    <Pravidlo typ="ne">Svatozář jako svislý kruh nebo plný disk. A nikdy ve tvaru děr ze štulpny.</Pravidlo>
    <Pravidlo typ="ok">Hlava kulatá, krémová, tmavá maska kolem očí, černé brýle, klidný úsměv.</Pravidlo>
    <Pravidlo typ="ok">Žíhání srsti tmavě hnědé — espresso, kaštan. Břicho světlé.</Pravidlo>
    <Pravidlo typ="ne">Žíhání zrzavé, rezavé nebo světle béžové. To je jiná postava.</Pravidlo>
    <Pravidlo typ="ok">Tělo štíhlé a pohodové. Dlouhé paže, tlapy se třemi drápy.</Pravidlo>
    <Pravidlo typ="ne">Svalnatý nebo atletický lenochod. Popírá to celou povahu značky.</Pravidlo>
    <Pravidlo typ="ok">Krabička matně černá se zlatým nápisem eldee, uvnitř štulpny.</Pravidlo>
    <Pravidlo typ="ne">V krabičce cokoliv jiného než štulpny. A nikdy naštvaný výraz.</Pravidlo>
  </Pravidla>

  <!-- ── Barvy ──────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Barvy maskota" meta={['Paleta značky + espresso']} />

  <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
    {paleta.map((c) => (
      <div class="rounded-lg overflow-hidden border border-bone/10">
        <div class="h-20" style={`background:${c.hex}`}></div>
        <div class="p-3">
          <div class="text-body text-bone">{c.name}</div>
          <div class="font-mono text-caption text-bone/50">{c.hex}</div>
          <div class="text-caption text-bone/40 mt-1">{c.note}</div>
        </div>
      </div>
    ))}
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Espresso je jediná barva navíc oproti paletě značky. Patří jen srsti.</Pravidlo>
    <Pravidlo typ="ne">Jakákoliv barva mimo tuhle pětici — včetně drop barev.</Pravidlo>
  </Pravidla>

  <!-- ── Pro produkci ───────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Pro tým a produkci" meta={['Kit · model sheet, 12 výrazů, 4 pózy', 'Web · PNG']} />

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    Maskot má <strong class="text-bone">hotový kit</strong> — model sheet, dvanáct výrazů a čtyři pózy značky.
    Identita je zamčená. Pro web a obrazovku je správný formát PNG; čistý vektor na výšivku,
    velký tisk a merch se teprve dělá.
  </p>

  <details class="border border-bone/10 rounded-lg p-5 mb-6">
    <summary class="font-mono text-caption text-gold cursor-pointer min-h-[44px] flex items-center">▸ Generování v AI — kotvy a prompt</summary>
    <p class="text-body text-bone/70 mt-4 mb-2">
      Kotvy, které musí sedět vždycky: zlatá plochá svatozář · černé brýle a klidný úsměv ·
      krémová srst s <strong class="text-bone">tmavě hnědým</strong> žíháním · tři drápy ·
      štulpny eldee (logo LD, červená linka, tři půlměsícové díry) · štíhlý, nikdy svalnatý.
      Vždycky generuj s referenčním obrázkem, nikdy jen z popisu.
    </p>
    <p class="text-body text-bone/70 mt-3 mb-2">Anglický prompt do AI nástrojů:</p>
    <pre class="text-caption text-bone/60 bg-bone/[0.04] p-4 rounded overflow-x-auto whitespace-pre-wrap">A chill cartoon sloth mascot, slim (not muscular), standing upright. Cream/off-white fur on belly, face and legs; DARK BROWN (espresso/chestnut, NOT orange) fur streaks on arms, back and as an eye mask. Black rounded sunglasses, happy smile. Flat horizontal GOLD halo ring above head. Three-clawed hands. Tall white "eldee" football socks: black ribbed cuff, black heel/toe, thin red outline, small gold "LD" logo on shin, three crescent holes with red edges showing cream skin. Clean flat vector streetwear illustration, bold outlines. Colors: off-white #F5F5F0, gold #C9A227, blood red #B91C1C, carbon black #0A0A0A.</pre>
  </details>

  <div class="grid md:grid-cols-2 gap-3">
    <AssetDownload href="/mascot/eldee-prodejce.png" label="Eldee — svatý prodejce" format="PNG" />
    <AssetDownload href="/mascot/eldee-fotbalista.png" label="Eldee — fotbalista" format="PNG" />
    <AssetDownload href="/mascot/eldee-srdicko.png" label="Eldee — srdíčko" format="PNG" />
  </div>
</Layout>
