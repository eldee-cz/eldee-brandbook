---
import Layout from '../components/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Ukazka from '../components/Ukazka.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Pravidla from '../components/Pravidla.astro';
import Pravidlo from '../components/Pravidlo.astro';
import Zakaz from '../components/Zakaz.astro';
import FotoMisto from '../components/FotoMisto.astro';

// Velikosti uvnitř ukázek jsou v `cqw` = procento šířky rámečku, ne obrazovky.
// Ukázka je zmenšený artboard: na telefonu má být stejná kompozice, jen menší.
// S `vw` nebo pevnými px se obsah z rámečku vylil a `overflow-hidden` ho ořízl.
---
<Layout title="Digitální aplikace">
  <SectionTitle
    title="Digitální aplikace"
    subtitle="Web, Instagram, TikTok, e-mail, podcast. Každý formát má rozměr, pravidla a hotovou ukázku."
  />

  <!-- ── Web ────────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Web — hero" meta={['21:9 · min 1920×1080', 'eldeeworld.com']} prvni />

  <Zakaz>Svatozář a claim „One of Us.“ nikdy jako hlavní motiv v jednom záběru. Na kusu oblečení smí být obojí, každé na jiném místě — třeba claim na zádech a logo na hrudi.</Zakaz>

  <!-- Revize 18. 9. 2026: lišta s logem, místo pro fotku hráče a mobilní verze (95 % návštěv). -->
  <div class="grid lg:grid-cols-[3fr_1fr] gap-4 items-start">
    <Ukazka format="hero" plocha="ink" popis="Počítač · 21:9">
      <FotoMisto class="right-0 inset-y-0 w-[56%]" velikost="1.6cqw" />
      <div class="absolute right-0 inset-y-0 w-[56%]" data-foto-prechod style="background:linear-gradient(90deg,#0A0A0A 0,rgba(10,10,10,.35) 30%,transparent 60%)" aria-hidden="true"></div>
      <div class="absolute inset-x-0 top-0 h-[6.4cqw] px-[4cqw] flex items-center justify-between border-b border-bone/10" style="background:rgba(10,10,10,.85)">
        <img src="/logo/wordmark-light.svg" alt="Logo eldee" class="h-[3cqw] w-auto" />
        <span class="font-mono text-[1.05cqw] tracking-[0.16em] uppercase text-bone/75 flex gap-[2.4cqw]"><span>Drop 001</span><span>Příběh</span><span>Kluby</span><span class="text-bone">Košík (0)</span></span>
      </div>
      <div class="relative mt-[5cqw]">
        <div class="font-mono text-[1.25cqw] tracking-[0.18em] uppercase text-gold mb-[2.2cqw]">Drop 001 · live</div>
        <div class="font-display italic text-[8cqw] leading-[0.95] text-bone">One of Us.</div>
        <div class="font-brush text-gold text-[3.2cqw] -rotate-2 origin-left mt-[1cqw] mb-[3.1cqw]">
          holy socks. no, just socks with holes.
        </div>
        <div class="flex gap-[1.3cqw]">
          <span class="bg-blood text-bone font-mono text-[1.35cqw] tracking-[0.1em] uppercase font-bold px-[2.2cqw] py-[1.1cqw]">Koupit</span>
          <span class="border border-bone/40 text-bone/85 font-mono text-[1.35cqw] tracking-[0.1em] uppercase px-[2.2cqw] py-[1.1cqw]">Příběh</span>
        </div>
      </div>
    </Ukazka>

    <div class="w-full max-w-[260px] mx-auto lg:max-w-none">
      <Ukazka format="telefon" plocha="ink" popis="Telefon · na výšku">
        <FotoMisto class="inset-x-0 top-0 h-[110cqw]" velikost="3.4cqw" />
        <div class="absolute inset-x-0 top-[70cqw] h-[40cqw]" data-foto-prechod style="background:linear-gradient(0deg,#0A0A0A,transparent)" aria-hidden="true"></div>
        <div class="absolute inset-x-0 top-[5cqw] h-[15cqw] px-[6cqw] flex items-center justify-between" style="background:linear-gradient(180deg,rgba(10,10,10,.7),transparent)">
          <img src="/logo/wordmark-light.svg" alt="Logo eldee" class="h-[7cqw] w-auto" />
          <span class="font-mono text-[3.6cqw] tracking-[0.16em] uppercase text-bone border border-bone/35 px-[3.4cqw] py-[2.4cqw]">Menu</span>
        </div>
        <div class="absolute inset-x-[6cqw] top-[104cqw]">
          <div class="font-mono text-[3.4cqw] tracking-[0.18em] uppercase text-gold mb-[3cqw]">Drop 001 · live</div>
          <div class="font-display italic text-[19cqw] leading-[0.95] text-bone">One of Us.</div>
          <div class="font-brush text-gold text-[6.4cqw] -rotate-2 origin-left mt-[2cqw] mb-[6cqw]">holy socks. no, just socks with holes.</div>
          <span class="flex items-center justify-center h-[13cqw] mb-[3cqw] bg-blood text-bone font-mono text-[4cqw] tracking-[0.1em] uppercase font-bold">Koupit</span>
          <span class="flex items-center justify-center h-[13cqw] border border-bone/40 text-bone/85 font-mono text-[4cqw] tracking-[0.1em] uppercase">Příběh</span>
        </div>
      </Ukazka>
    </div>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Claim značky nahoře, produktová linka pod ním. Nikdy obráceně.</Pravidlo>
    <Pravidlo typ="ok">Jedno hlavní tlačítko v Blood Red, druhé jen obrys. Na telefonu přes celou šířku, aspoň 44 px vysoká.</Pravidlo>
    <Pravidlo typ="rozmer">Počítač 21:9, nejméně 1920×1080 px. Telefon na výšku: fotka nahoře, claim pod ní.</Pravidlo>
  </Pravidla>

  <!-- ── Instagram ──────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Instagram" meta={['1080×1080', 'rytmus 1 video týdně']} />

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <Ukazka format="ctverec" plocha="ink" popis="Drop announcement">
      <FotoMisto class="inset-x-0 top-0 h-[62%]" popis="fotka hráče ve štulpnách" velikost="3cqw" />
      <div class="absolute inset-x-0 top-[40%] h-[22%]" data-foto-prechod style="background:linear-gradient(0deg,#0A0A0A,transparent)" aria-hidden="true"></div>
      <div class="absolute left-[8cqw] bottom-[7cqw] text-left">
        <div class="font-mono text-[3.2cqw] tracking-[0.18em] uppercase text-gold mb-[2cqw]">Drop 001</div>
        <div class="font-display italic text-[13cqw] leading-[0.95] text-blood">Holy Socks.</div>
        <div class="font-mono text-[3.2cqw] tracking-[0.18em] text-bone/40 mt-[2.4cqw]">@eldee.cz</div>
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="bone" popis="Meme — pilíř comedy">
      <div class="font-display italic text-[10.5cqw] leading-tight text-ink">
        POV: trénink za 5 minut, štulpny ještě v krabičce.
      </div>
      <div class="font-mono text-[3.2cqw] tracking-[0.18em] text-blood mt-[6cqw]">#holysocks</div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="blood" popis="UGC repost — razítko">
      <FotoMisto class="inset-x-0 top-0 h-[56%]" popis="fotka od hráče = důkaz" velikost="3cqw" />
      <div class="absolute left-[8cqw] right-[8cqw] bottom-[7cqw] text-left">
        <div class="font-mono text-[3.2cqw] tracking-[0.18em] uppercase text-bone/70 mb-[2cqw]">Repost</div>
        <div class="font-display italic text-[10.5cqw] leading-[1.02] text-bone">„Tyhle jsou jiný.“</div>
        <div class="font-brush text-[7.5cqw] text-bone mt-[1.5cqw]">one of us.</div>
      </div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Hrdina je vždycky hráč, nikdy produkt.</Pravidlo>
    <Pravidlo typ="ok">Mluvíme „my“, ne „oni“.</Pravidlo>
    <Pravidlo typ="ne">„One of Us.“ jako nápis na obrázku. Jediná výjimka je repost — tam odpovídá hráči, který přinesl důkaz.</Pravidlo>
  </Pravidla>

  <!-- ── TikTok / Reels ─────────────────────────────────────────────────── -->
  <PasHlavicka nazev="TikTok / Reels" meta={['1080×1920', 'bezpečná zóna 12 %']} />

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <Ukazka format="svisle" plocha="ink" zona zonaStitek popis="Drop">
      <div class="font-mono text-[4.6cqw] tracking-[0.15em] uppercase text-gold mb-[5cqw]">Drop 001</div>
      <div class="font-display italic text-[16.5cqw] leading-[0.95] text-bone">ONE OF<br/>US.</div>
      <div class="font-brush text-[10cqw] text-gold mt-[4cqw]">drop incoming.</div>
    </Ukazka>

    <Ukazka format="svisle" plocha="uhel" zona popis="Comedy">
      <div class="font-display italic text-[15.5cqw] leading-[0.95] text-bone">STŘÍHAT<br/>NEBO<br/>NOSIT?</div>
      <div class="font-mono text-[4.6cqw] tracking-[0.15em] text-bone/40 mt-[5cqw]">@eldee.cz</div>
    </Ukazka>

    <Ukazka format="svisle" plocha="bone" zona popis="Player hype">
      <FotoMisto class="inset-x-0 top-0 h-[50%]" popis="hráč před zápasem" svetla velikost="4.4cqw" />
      <div class="absolute inset-x-[12cqw] top-[56%]">
        <div class="font-display italic text-[16cqw] leading-[0.95] text-ink">PRVNÍ<br/>ZÁPAS</div>
        <div class="font-mono text-[4.6cqw] tracking-[0.15em] text-blood mt-[5cqw]">holy socks</div>
      </div>
    </Ukazka>

    <Ukazka format="svisle" plocha="blood" zona popis="Founder / návod">
      <div class="font-display italic text-[14.5cqw] leading-[0.95] text-bone">MĚŘENÍ<br/>LÝTKA</div>
      <div class="font-brush text-[9.5cqw] text-bone mt-[4cqw]">návod.</div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ne">Text do zlatě vyznačené zóny. Překryje ho rozhraní aplikace.</Pravidlo>
    <Pravidlo typ="ok">Titulek do tří slov. Zbytek řekne obraz.</Pravidlo>
    <Pravidlo typ="ok">Obálka patří k pilíři obsahu, ne k náhodné estetice.</Pravidlo>
  </Pravidla>

  <!-- ── E-mail a podcast ───────────────────────────────────────────────── -->
  <PasHlavicka nazev="E-mail a podcast" meta={['podpis 480 px', 'obálka 3000×3000']} />

  <div class="grid lg:grid-cols-[1.4fr_1fr] gap-4 items-start">
    <!-- Podpis je jediná ukázka v reálné velikosti — čte se, neprohlíží. -->
    <!-- Revize 18. 9. 2026: podpis uvidí příjemce na bílé, ne na černé. Gmail ani Outlook
         písmo značky nenačtou, proto systémové písmo; logo nese značku na vlastní černé dlaždici. -->
    <Ukazka format="volny" plocha="bila" popis="Podpis do e-mailu — tak, jak ho uvidí příjemce">
      <div style="font-family:Arial,Helvetica,sans-serif">
        <div class="text-[15px] text-[#202124]">Díky za rychlou odpověď, vzorky pošlu v pondělí.</div>
        <div class="text-[15px] text-[#202124]/50 my-3">--</div>
        <div class="text-[17px] font-bold text-[#202124]">Lukáš Hledík <span class="text-[13px] font-normal text-[#202124]/60 ml-1">CEO</span></div>
        <div class="inline-block rounded-md px-3 py-2.5 my-2.5 leading-none" style="background:#0A0A0A"><img src="/logo/wordmark-light.svg" alt="Logo eldee" class="block h-[30px] w-auto" /></div>
        <div class="text-[13px] leading-[1.75] text-[#202124]/80">
          <div>lukas@eldee.cz</div>
          <div>+420 000 000 000</div>
          <div>eldeeworld.com · @eldee.cz</div>
        </div>
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="ink" popis="Obálka podcastu">
      <div class="font-mono text-[3.2cqw] tracking-[0.18em] uppercase text-gold mb-[4.5cqw]">Epizoda 01</div>
      <div class="font-display italic text-[14cqw] leading-[0.95] text-bone">HOLY<br/>SOCKS.</div>
      <div class="font-brush text-[8.7cqw] text-gold mt-[4cqw]">podcast.</div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Podpis: jméno, role česky (jak je ve firmě), značka, kontakt. Nic víc.</Pravidlo>
    <Pravidlo typ="ok">Podpis se ukazuje na bílé. Logo vždy na černé dlaždici jako obrázek PNG, nikdy průhledné.</Pravidlo>
    <Pravidlo typ="ne">Claim značky na obálce podcastu. Ta drží produktovou linku.</Pravidlo>
  </Pravidla>

</Layout>
