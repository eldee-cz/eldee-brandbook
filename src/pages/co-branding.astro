---
import Layout from '../components/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Ukazka from '../components/Ukazka.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Pravidla from '../components/Pravidla.astro';
import Pravidlo from '../components/Pravidlo.astro';
import Zakaz from '../components/Zakaz.astro';

// Velikosti uvnitř ukázek jsou v `cqw` = procento šířky rámečku. Viz Ukazka.astro.
---
<Layout title="Spojení s partnery">
  <SectionTitle
    title="Spojení s partnery"
    subtitle="Pravidla pro spojení eldee s klubem, ambasadorem a sponzorskou pozicí."
  />

  <!-- ── Klub ───────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Klub — lockup" meta={['pořadí eldee × KLUB', 'mezera = výška „e“']} prvni />

  <Ukazka format="pruh" plocha="ink" popis="eldee × FK Pankrác">
    <div class="flex items-center justify-center gap-[4cqw]">
      <span class="font-display italic text-[11cqw] text-bone leading-none">eldee</span>
      <span class="font-mono text-[7cqw] text-gold leading-none">×</span>
      <span class="font-display text-[8.2cqw] text-bone leading-none">FK PANKRÁC</span>
    </div>
  </Ukazka>

  <Pravidla>
    <Pravidlo typ="ok">Obě loga mají stejnou optickou výšku. Křížek je zlatý a stojí mezi nimi.</Pravidlo>
    <Pravidlo typ="ok">Pořadí je vždy „eldee × KLUB“, nikdy obráceně.</Pravidlo>
    <Pravidlo typ="rozmer">Mezera mezi logy = výška písmene „e“ ve wordmarku eldee.</Pravidlo>
  </Pravidla>

  <!-- ── Ambasador ──────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Ambasador — certifikát" meta={['osobní kód', 'podmínky řeší smlouva']} />

  <Zakaz>Do brand booku nepatří odměny ani plnění pro ambasadory. Ta čísla žijí ve smlouvě, ne ve veřejné příručce.</Zakaz>

  <div class="grid lg:grid-cols-[1.5fr_1fr] gap-4 items-start">
    <Ukazka format="krabice" plocha="ink" popis="Certifikát ambasadora">
      <div class="absolute inset-[4cqw] border-2 border-gold/40 pointer-events-none"></div>
      <div class="w-full flex justify-between items-start">
        <div class="font-mono text-[2.8cqw] tracking-[0.18em] uppercase text-gold">Ambassador · 2026</div>
        <div class="font-display italic text-[7cqw] text-bone leading-none">eldee</div>
      </div>
      <div class="w-full text-left mt-auto">
        <div class="font-mono text-[2.6cqw] tracking-[0.18em] uppercase text-bone/60 mb-[1cqw]">Certified</div>
        <div class="font-display italic text-[11cqw] text-bone leading-none">JAKUB NOVÁK</div>
        <div class="font-mono text-[2.8cqw] tracking-[0.15em] uppercase text-blood mt-[2cqw]">Code: JAKUB10</div>
      </div>
    </Ukazka>

    <Ukazka format="ctverec" plocha="podklad" popis="Co v kitu je">
      <div class="font-mono text-[3.4cqw] tracking-[0.18em] uppercase text-gold mb-[5cqw]">Kit</div>
      <div class="font-display italic text-[8.5cqw] text-bone leading-tight">Certifikát<br/>+ pár štulpen<br/>+ samolepky</div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Jméno ambasadora je na certifikátu největší prvek. Hrdina je hráč, ne značka.</Pravidlo>
    <Pravidlo typ="ok">Kód se skládá ze jména a čísla, vždy verzálkami.</Pravidlo>
    <Pravidlo typ="rozmer">Zlatý rámeček 2 px, odsazený od hrany o šířku písmene „e“.</Pravidlo>
  </Pravidla>

  <!-- ── Sponzor ────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Sponzor — podpis" meta={['na klubovém materiálu', 'výška wordmarku max 1/6 šířky']} />

  <Ukazka format="pruh" plocha="podklad" popis="Podpis na klubovém materiálu">
    <div class="flex items-center justify-between w-full">
      <span class="font-mono text-[3.2cqw] tracking-[0.18em] uppercase text-bone/60">Oficiální partner</span>
      <span class="font-display italic text-[8cqw] text-bone leading-none">eldee</span>
    </div>
  </Ukazka>

  <Pravidla>
    <Pravidlo typ="ok">Na cizím materiálu drží eldee roli podpisu — malé, vpravo, bez claimu.</Pravidlo>
    <Pravidlo typ="ne">Claim „One of Us.“ na klubovém materiálu. Ten patří jen na vlastní plochu.</Pravidlo>
    <Pravidlo typ="ne">Svatozář v partnerském spojení. Nikdy.</Pravidlo>
  </Pravidla>

  <!-- ── Merch ──────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Merch pro kolaborace" meta={['nášivka ~8 × 3 cm', 'banner 3 × 0,5 m']} />

  <div class="grid gap-4">
    <Ukazka format="pruh" plocha="blood" popis="Nášivka na dres (~8 × 3 cm)">
      <div class="text-center">
        <span class="font-display italic text-[20cqw] text-bone leading-none">eldee</span>
      </div>
    </Ukazka>

    <Ukazka format="banner" plocha="ink" popis="Banner na stadion (3 × 0,5 m)">
      <div class="flex items-center justify-between w-full">
        <span class="font-display italic text-[11cqw] text-bone leading-none">eldee</span>
        <span class="font-brush text-gold text-[7cqw] -rotate-2">holy socks.</span>
      </div>
    </Ukazka>
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Nášivka jde vyšívat — žádné tenké linky ani drobné vnitřní tvary.</Pravidlo>
    <Pravidlo typ="rozmer">Nejtenčí tah ve výšivce nejméně 4 mm v hotové velikosti.</Pravidlo>
    <Pravidlo typ="ne">Zmenšovat wordmark na banneru pod výšku, kde se přestane číst ze třiceti metrů.</Pravidlo>
  </Pravidla>

</Layout>
