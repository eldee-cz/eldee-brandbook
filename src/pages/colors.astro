---
import Layout from '../components/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PasA from '../components/PasA.astro';
import TabulkaBarev from '../components/TabulkaBarev.astro';
import Pravidla from '../components/Pravidla.astro';
import Pravidlo from '../components/Pravidlo.astro';
import Zakaz from '../components/Zakaz.astro';
import colorsData from '../data/colors.json';
import { pomer, INK } from '../data/kontrast';

// Varianta A (pravidlo vede): HEX/RGB/CMYK/Pantone je tabulka, ne galerie,
// a pravidlo patří ke své skupině barev — ne do seznamu na konci stránky,
// kam se člověk hledající CMYK zlaté nikdy nedostane.
const skupina = (id: string) => colorsData.groups.find((g) => g.id === id)!;

// Čísla v textu se počítají ze stejného zdroje jako tabulka, ať se nemůžou
// rozejít. Dřív byla vypsaná ručně a nesouhlasila.
const k = (hex: string) => pomer(hex, INK).toFixed(1);

// Počet v nadpisu se taky počítá z dat. Při odebrání tří odstínů (revize
// 15. 9. 2026) by ručně psaných „13 barev“ zůstalo viset.
const pocetBarev = colorsData.groups.reduce((n, g) => n + g.colors.length, 0);
---
<Layout title="Barvy">
  <SectionTitle
    title={`${pocetBarev} barev, ${colorsData.groups.length} vrstev`}
    subtitle="Černá nese plochu, červená značku, zlatá výjimečné momenty. Drop barvy se mění, signální pár řídí čtení téhle knihy."
  />

  <PasA
    nazev="Canvas"
    popis="Neutrální vrstva. Tvoří 90 % vizuálního pole — všechno ostatní je akcent na ní."
    spec={['Podíl · ~90 % plochy', 'Podklad · Carbon Black']}
    prvni
  >
    <Pravidla slot="pravidla" sloupec>
      <Pravidlo typ="ok">Canvas drží plochu vždycky. Barevná plocha je výjimka, ne výchozí stav.</Pravidlo>
      <Pravidlo typ="ok">Off-white je jediná světlá plocha značky. Čistě bílou nepoužíváme.</Pravidlo>
    </Pravidla>
    <TabulkaBarev barvy={skupina('canvas').colors} legenda />
  </PasA>

  <PasA
    nazev="Signature"
    popis="Blood Red je barva značky. Nese wordmark, hlavní tlačítko a akcent — a nic víc."
    spec={[`Blood Red na černé · ${k('#B91C1C')}`, 'Stálost · 5+ let']}
  >
    <Fragment slot="pravidla">
      <Zakaz>
        Blood Red nikdy na drobný text na černé. Kontrast {k('#B91C1C')} stačí jen na nápisy
        od 24 px, nebo od 19 px tučně.
      </Zakaz>
      <Pravidla sloupec>
        <Pravidlo typ="ok">Jedno hlavní tlačítko v Blood Red na obrazovku. Druhé jen obrys.</Pravidlo>
        <Pravidlo typ="ok">
          Když si nejsi jistý čitelností na černé, sáhni po zlaté ({k('#C9A227')}) nebo po Off-white.
        </Pravidlo>
      </Pravidla>
    </Fragment>
    <TabulkaBarev barvy={skupina('signature').colors} />
  </PasA>

  <PasA
    nazev="Premium Accent"
    popis="Zlatá je výjimka, ne druhá značková barva. Svatozář, Holy edice, certifikát ambasadora."
    spec={[`Burnished Gold na černé · ${k('#C9A227')}`, 'Tisk · tisk nebo ražba, ne CMYK']}
  >
    <Pravidla slot="pravidla" sloupec>
      <Pravidlo typ="ok">Zlatá je bezpečná i na drobný text — je to nejčitelnější akcent značky.</Pravidlo>
      <Pravidlo typ="ne">Zlatá a Blood Red vedle sebe jako dva akcenty v jednom záběru. Jeden vede.</Pravidlo>
      <Pravidlo typ="rozmer">Zlatá se tiskne nebo razí — technika podle dodavatele, nikdy ne ze čtyř tiskových barev. Ta vyjde špinavě žlutá.</Pravidlo>
    </Pravidla>
    <TabulkaBarev barvy={skupina('premium').colors} />
  </PasA>

  <PasA
    nazev="Drop Accents"
    popis="Sezónní barvy jednoho dropu. Nepatří do identity — mění se a zase odejdou."
    spec={['Platnost · jeden drop', 'Počet · jedna na kampaň']}
  >
    <Pravidla slot="pravidla" sloupec>
      <Pravidlo typ="ne">Dvě drop barvy v jednom designu. Vždycky jen jedna.</Pravidlo>
      <Pravidlo typ="ne">Drop barva na logu, wordmarku nebo v podpisu. Zůstává v kampani.</Pravidlo>
      <Pravidlo typ="ne">
        Electric Blue na drobný text na černé — má jen {k('#2563EB')}, stejně jako Blood Red
        unese pouze velké nápisy.
      </Pravidlo>
    </Pravidla>
    <TabulkaBarev barvy={skupina('drop').colors} />
  </PasA>

  <PasA
    nazev="Signal"
    popis="Dvě barvy, které neříkají, kdo eldee je — říkají čtenáři, jestli se dívá na pravidlo, nebo na zákaz. Proto stojí mimo identitu a smějí být světlejší, než by se značce líbilo."
    spec={[`Signal OK na černé · ${k('#10B981')}`, `Signal Ne na černé · ${k('#F87171')}`]}
  >
    <Fragment slot="pravidla">
      <Pravidla sloupec>
        <Pravidlo typ="ok">
          Signální pár nese jen štítky a karty pravidel uvnitř téhle knihy. Na produkt,
          obal ani do kampaně nepatří — tam jede Blood Red.
        </Pravidlo>
        <Pravidlo typ="rozmer">
          V tisku se nepoužívají vůbec. Na bílém papíře mají kontrast 2.8 a 2.5, takže
          se automaticky převádějí na tmavé protějšky #B91C1C a #047857. Proto nemají Pantone.
        </Pravidlo>
        <Pravidlo typ="ne">
          Zaměňovat Signal Ne za Blood Red. Značková červená se od signální liší záměrně:
          Blood Red má na černé {k('#B91C1C')} a drobný text neunese.
        </Pravidlo>
      </Pravidla>
    </Fragment>
    <TabulkaBarev barvy={skupina('signal').colors} />
  </PasA>
</Layout>
