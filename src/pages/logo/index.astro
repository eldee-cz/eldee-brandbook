---
import Layout from '../../components/Layout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import PasHlavicka from '../../components/PasHlavicka.astro';
import Pravidla from '../../components/Pravidla.astro';
import Pravidlo from '../../components/Pravidlo.astro';
import Zakaz from '../../components/Zakaz.astro';
import LogoVariant from '../../components/LogoVariant.astro';
import AssetDownload from '../../components/AssetDownload.astro';

// Rozvržení B2: ukázka vede, pravidla v kartách pod ní.
//
// Obsah je stejný jako ve v2.0, jen rozložený. Dřív stál nad každou mřížkou
// odstavec na šest řádků, ve kterém byla schovaná pravidla („nikdy neposílat
// SVG do vyšívárny“) i rozměry („spára 1,8 mm“) — mezi souvětími o tom, jak
// logo vzniklo. Teď: popis je jedna věta, rozměry jsou v hlavičce pásu,
// pravidla v kartách pod ukázkou.
---
<Layout title="Logo">
  <SectionTitle
    title="Dvě vrstvy loga"
    subtitle="Wordmark pro marketing, monogram LD pro výšivku. Jedno logo ve dvou velikostech použití — ne dvě různá loga."
  />

  <!-- ── Wordmark ───────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Wordmark" meta={['Nejmenší velikost · 24 px / 8 mm', 'Big Shoulders Display Black']} prvni />

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    Hlavní logo značky: slovo „eldee“ s monogramem LD <strong class="text-bone">vyříznutým přímo z něj</strong>,
    ne přilepeným vedle. Blok LD se svatozáří stojí na ose malých „e“, D podsedá pod účaří.
    Pro web, Instagram, krabičky, vizitky a obálku podcastu.
  </p>

  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
    <LogoVariant src="/logo/wordmark-light.svg" alt="Wordmark eldee na černé" bg="ink" caption="Na tmavém podkladu" />
    <LogoVariant src="/logo/wordmark-dark.svg" alt="Wordmark eldee na světlé" bg="bone" caption="Na světlém podkladu" />
    <LogoVariant src="/logo/wordmark-light.svg" alt="Wordmark eldee na červené" bg="blood" caption="Na Blood Red" />
    <!-- Na zlaté je celé logo tmavé, i prstenec. Světlá verze má na #C9A227
         kontrast 2.2 a neprojde ani minimem 3:1 pro grafiku; tmavá má 8.2.
         Samotná tmavá ale nestačí: její prstenec je zlatý a na zlaté splyne
         (kontrast 1:1) — do revize 15. 9. 2026 tu viselo logo bez prstence. -->
    <LogoVariant src="/logo/wordmark-on-gold.svg" alt="Wordmark eldee na zlaté" bg="gold" caption="Na zlaté — Holy edice" />
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Wordmark je bez sklonu. Skloněná verze je logo v1 a to se od 6/2026 nepoužívá.</Pravidlo>
    <Pravidlo typ="ne">Přidávat k wordmarku svatozář. Už ji obsahuje — druhá by nad ní visela jako chyba.</Pravidlo>
    <Pravidlo typ="ne">Světlá verze na zlaté. Má kontrast 2.2, což neprojde ani minimem 3 : 1 pro grafiku — na zlatou patří tmavá.</Pravidlo>
    <Pravidlo typ="rozmer">Nejmenší velikost 24 px na webu, 8 mm v tisku. Pod to jde monogram, ne zmenšený wordmark.</Pravidlo>
  </Pravidla>

  <!-- ── Vertikální lockup ──────────────────────────────────────────────── -->
  <PasHlavicka nazev="Svislá varianta" meta={['Pořadí · e – LD – e – e', 'Úzké formáty']} />

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    Totéž logo poskládané pod sebe. Monogram stojí na ose dvojpísmene LD, svislé rozestupy
    odpovídají mezerám mezi písmeny ve vodorovném nápisu. Pro bočnice, svislé bannery,
    záložky, štítek na štulpně a vodoznak.
  </p>

  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    <LogoVariant src="/logo/wordmark-vertical-light.svg" alt="Svislý wordmark na černé" bg="ink" caption="Na tmavém podkladu" />
    <LogoVariant src="/logo/wordmark-vertical-dark.svg" alt="Svislý wordmark na světlé" bg="bone" caption="Na světlém podkladu" />
    <LogoVariant src="/logo/wordmark-vertical-on-gold.svg" alt="Svislý wordmark na zlaté" bg="gold" caption="Na zlaté — Holy edice" />
  </div>

  <Pravidla>
    <Pravidlo typ="ok">Platí pro ni všechna pravidla vodorovného wordmarku. Není to jiné logo.</Pravidlo>
    <Pravidlo typ="ok">Použij ji jen tam, kde se vodorovný nápis nevejde — ne pro změnu.</Pravidlo>
  </Pravidla>

  <!-- ── Monogram ───────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Monogram LD" meta={['Nejmenší velikost · 16 px / 5 mm', 'Ochranná zóna · výška „L“']} />

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    L proniká skrz D a obě písmena tvoří <strong class="text-bone">jedno srostlé těleso</strong>.
    V průniku zůstává průhledná spára, takže monogram drží čitelnost na světlém i tmavém podkladu.
    Nad D se vznáší zlatá svatozář — odkaz na Holy Socks.
  </p>

  <div class="grid md:grid-cols-2 gap-4">
    <LogoVariant src="/logo/monogram-ld.svg" alt="Monogram LD s vyznačenou ochrannou zónou" bg="ink" showSafeZone={true} caption={'Ochranná zóna = výška „L“'} />
    <LogoVariant src="/logo/monogram-ld.svg" alt="Monogram LD na červené" bg="blood" caption="Na Blood Red" />
  </div>

  <Pravidla>
    <Pravidlo typ="ne">Zalít spáru mezi L a D. Interlock pak splyne v nečitelný slitek.</Pravidlo>
    <Pravidlo typ="ok">Monogram je jediná povolená zkratka loga. Zkratky typu „e“ neexistují.</Pravidlo>
    <Pravidlo typ="rozmer">Kolem monogramu vždy volno nejméně na výšku „L“ — i vedle loga klubu.</Pravidlo>
  </Pravidla>

  <!-- ── Výšivka ────────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Výšivka" meta={['Nášivka · 35 mm', 'Tahy 5,6 · spára 1,8 · prsten 1,6 mm']} />

  <Zakaz>Do vyšívárny nikdy neposílej SVG. Vždy přes digitizéra (PES/DST) a nejdřív zkušební výšivku na úpletu.</Zakaz>

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    Logo je navržené jehlou, ne obtažené po návrhu: každý tah, spára i prsten svatozáře drží
    tloušťky, které jehla unese při nášivce 35 mm. Proto existuje
    <strong class="text-bone">jediná podoba monogramu</strong> — co je na štulpně, je i na webu.
  </p>

  <div class="grid md:grid-cols-2 gap-4">
    <LogoVariant src="/logo/monogram-mono.svg" alt="Monogram v jedné barvě" bg="ink" caption="Jednobarevná verze" />
    <LogoVariant src="/logo/monogram-mono.svg" alt="Monogram na červené" bg="blood" caption="Cíl výšivky — nášivka 35 mm" />
  </div>

  <Pravidla>
    <Pravidlo typ="rozmer">Při 35 mm: tahy písmen 5,6 mm, spára 1,8 mm, prsten svatozáře 1,6 mm, otvor 2,2 mm.</Pravidlo>
    <Pravidlo typ="ok">Před sérií vždy zkušební výšivka na tom úpletu, ze kterého se bude vyrábět.</Pravidlo>
    <Pravidlo typ="ok">Na jednobarevné aplikace je připravená mono verze, ne ručně odbarvený master.</Pravidlo>
  </Pravidla>

  <!-- ── Svatozář ───────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Svatozář" meta={['Burnished Gold #C9A227', 'Druhotný symbol']} />

  <Zakaz>Svatozář a claim „One of Us.“ nikdy jako hlavní motiv v jednom záběru. Na kusu oblečení smí být obojí, každé na jiném místě — třeba claim na zádech a logo na hrudi.</Zakaz>

  <p class="text-body-lg text-bone/70 max-w-2xl mb-5">
    Náš protějšek streetwearové korunky. Odkazuje na Holy Socks — tedy na produkt,
    ne na hodnoty. Proto se nepotkává s claimem značky ani s hodnotovým a náboženským jazykem.
  </p>

  <div class="grid md:grid-cols-2 gap-4">
    <LogoVariant src="/logo/halo.svg" alt="Svatozář ve zlaté" bg="ink" caption="Burnished Gold #C9A227" />
  </div>

  <Pravidla>
    <Pravidlo typ="ne">Přidávat svatozář nad wordmark nebo monogram. Oba ji už mají v sobě.</Pravidlo>
    <Pravidlo typ="ok">Samostatně jen v produktovém kontextu — na krabičce, štítku, obalu.</Pravidlo>
  </Pravidla>

  <!-- ── Společná pravidla ──────────────────────────────────────────────── -->
  <PasHlavicka nazev="Platí na všechno" meta={['Jedno logo', 'Odvozeniny jen barevné']} />

  <Pravidla>
    <Pravidlo typ="ne">Měnit poměr stran, překlápět, rotovat nebo barvit mimo barvy značky.</Pravidlo>
    <Pravidlo typ="ne">Vyrábět „webovou verzi“ nebo „jemnější variantu“. Tvarové odvozeniny neexistují.</Pravidlo>
    <Pravidlo typ="ok">Povolené odvozeniny jsou jen barevné: základní a jednobarevná.</Pravidlo>
    <Pravidlo typ="rozmer">Foil tisk ve zlaté je vyhrazený Holy edici na krabičkách.</Pravidlo>
  </Pravidla>

  <div class="flex flex-wrap gap-x-6 gap-y-2 mt-6">
    <a href="/logo/construction" class="font-mono text-caption text-gold hover:text-bone transition">→ Konstrukční mřížka</a>
    <a href="/logo/misuse" class="font-mono text-caption text-gold hover:text-bone transition">→ Logo — co ne</a>
  </div>

  <!-- ── Ke stažení ─────────────────────────────────────────────────────── -->
  <PasHlavicka nazev="Ke stažení" meta={['Formát · SVG']} />

  <div class="grid md:grid-cols-2 gap-3">
    <AssetDownload href="/logo/wordmark-light.svg" label="Wordmark — světlá verze" format="SVG" />
    <AssetDownload href="/logo/wordmark-dark.svg" label="Wordmark — tmavá verze" format="SVG" />
    <AssetDownload href="/logo/wordmark-vertical-light.svg" label="Svislý wordmark — světlá verze" format="SVG" />
    <AssetDownload href="/logo/wordmark-vertical-dark.svg" label="Svislý wordmark — tmavá verze" format="SVG" />
    <AssetDownload href="/logo/wordmark-vertical-mono.svg" label="Svislý wordmark — jednobarevný" format="SVG" />
    <AssetDownload href="/logo/wordmark-on-gold.svg" label="Wordmark — na zlatou" format="SVG" />
    <AssetDownload href="/logo/wordmark-vertical-on-gold.svg" label="Svislý wordmark — na zlatou" format="SVG" />
    <AssetDownload href="/logo/monogram-ld.svg" label="Monogram LD — master" format="SVG" />
    <AssetDownload href="/logo/monogram-mono.svg" label="Monogram LD — jednobarevný" format="SVG" />
    <AssetDownload href="/logo/halo.svg" label="Svatozář" format="SVG" />
  </div>
</Layout>
