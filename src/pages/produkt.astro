---
import Layout from '../components/Layout.astro';
import { isHQ } from '../buildMode';
import { skryvatVeVerejnem } from '../data/sekce';
if (!isHQ && skryvatVeVerejnem(Astro.url.pathname)) return Astro.redirect('/');
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Karta from '../components/Karta.astro';
import Panel from '../components/Panel.astro';
import Doraz from '../components/Doraz.astro';
import content from '../data/content.json';

const pr = content.produkt;
---
<Layout title="Produkt">
  <SectionTitle
    title="Co eldee vyrábí"
    subtitle={pr.uvod}
  />

  <!-- Dva chráněné vzory — to, co konkurence nesmí okopírovat -->
  <PasHlavicka nazev="Dva chráněné vzory" hlas prvni />
  <div class="grid md:grid-cols-2 gap-5">
    {pr.vzory.map((v) => (
      <Karta nadpis={v.nazev} hrana="blood">{v.text}</Karta>
    ))}
  </div>

  <PasHlavicka
    nazev="Řada"
    hlas
    linka
    popis="Zápas i trénink — eldee na noze každý den, ne jen o víkendu."
  />
  <div class="grid md:grid-cols-2 gap-5">
    {pr.rada.map((r, i) => (
      <Karta cislo={String(i + 1).padStart(2, '0')} nadpis={r.name} hrana="gold">
        {r.role}
        {r.pozn && (
          <span class="block mt-3 pl-3 border-l-2 border-gold/40 text-gold/85">{r.pozn}</span>
        )}
      </Karta>
    ))}
  </div>

  <PasHlavicka nazev="Velikosti" hlas linka popis={pr.velikosti.uvod} />
  <div class="flex flex-wrap gap-3">
    {pr.velikosti.rady.map((v) => (
      <div class="border border-bone/20 px-8 py-5 font-display text-h2 italic text-bone">{v}</div>
    ))}
  </div>
  <Doraz barva="tlumena">{pr.velikosti.pozn}</Doraz>

  <PasHlavicka nazev={pr.vyroba.nadpis} hlas linka />
  <Panel hrana="zadna">
    <p class="text-body-lg text-bone/85 max-w-3xl">{pr.vyroba.text}</p>
    <Doraz>{pr.vyroba.pravidlo}</Doraz>
  </Panel>
</Layout>
