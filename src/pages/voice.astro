---
import Layout from '../components/Layout.astro';
import { isHQ } from '../buildMode';
import { skryvatVeVerejnem } from '../data/sekce';
if (!isHQ && skryvatVeVerejnem(Astro.url.pathname)) return Astro.redirect('/');
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Karta from '../components/Karta.astro';
import Panel from '../components/Panel.astro';
import Doraz from '../components/Doraz.astro';
import voice from '../data/voice-examples.json';

const templateLabels: Record<string, string> = {
  igCaptionLaunch:  'IG CAPTION · LAUNCH',
  igCaptionMeme:    'IG CAPTION · MEME',
  emailClubOpener:  'EMAIL · KLUB OPENER',
  podcastIntro:     'PODCAST · INTRO',
  pressReleaseHead: 'PRESS RELEASE · HEADLINE',
};
---
<Layout title="Voice & Tone">
  <SectionTitle
    title="Jak eldee mluví"
    subtitle="Pravidla pro psaní. Pro web, IG, e-maily, podcast, press."
  />

  <!-- Tři pravidla jsou provozní filtr z listu emočního jádra (25. 8. 2026).
       Stojí nad principy — když kus neprojde jimi, na tónu už nezáleží. -->
  <PasHlavicka nazev="Tři pravidla na každý post" hlas prvni popis={voice.pravidla.uvod} />
  <div class="grid md:grid-cols-3 gap-5">
    {voice.pravidla.seznam.map((p) => (
      <Karta cislo={p.cislo} nadpis={p.nazev} detail={p.vyjimka} hrana="gold">{p.text}</Karta>
    ))}
  </div>
  <Doraz barva="blood">{voice.pravidla.claim}</Doraz>

  <PasHlavicka nazev="Principy" hlas linka />
  <!-- Dvojice nese dvě věci: heslo a jeho ukázku. Proto nepoužívá kartu
       Pravidlo z bloků II a III — ta umí jen jednu větu. -->
  <div class="space-y-4">
    {voice.principles.map((p) => (
      <div class="grid md:grid-cols-2 gap-4">
        <div class="bg-ink/60 border-l-[3px] border-[#10B981] px-5 py-4">
          <div class="font-mono text-caption text-[#10B981] mb-2">✓ DO — {p.do}</div>
          <div class="text-body text-bone/80 italic">„{p.exampleDo}"</div>
        </div>
        <div class="bg-ink/60 border-l-[3px] border-blood px-5 py-4">
          <div class="font-mono text-caption text-blood mb-2">✗ DON'T — {p.dont}</div>
          <div class="text-body text-bone/80 italic">„{p.exampleDont}"</div>
        </div>
      </div>
    ))}
  </div>

  <PasHlavicka nazev="Slovník" hlas linka />
  <div class="grid md:grid-cols-2 gap-5">
    <div class="bg-ink/60 border border-[#10B981]/30 px-6 py-5">
      <div class="font-mono text-caption text-[#10B981] mb-3">POUŽÍVEJ</div>
      <div class="flex flex-wrap gap-2">
        {voice.vocabulary.use.map((w) => (
          <span class="bg-[#10B981]/10 text-[#A7F3D0] px-3 py-1 text-body">{w}</span>
        ))}
      </div>
    </div>
    <div class="bg-ink/60 border border-blood/30 px-6 py-5">
      <div class="font-mono text-caption text-blood mb-3">NEPOUŽÍVEJ</div>
      <div class="flex flex-wrap gap-2">
        {voice.vocabulary.dont.map((w) => (
          <span class="bg-blood/10 text-bone/70 px-3 py-1 text-body line-through">{w}</span>
        ))}
      </div>
    </div>
  </div>

  <PasHlavicka nazev="Šablony" hlas linka />
  <div class="space-y-4">
    {Object.entries(voice.templates).map(([key, value]) => (
      <Panel hrana="zadna">
        <div class="font-mono text-caption text-gold mb-3">{templateLabels[key] ?? key.toUpperCase()}</div>
        <pre class="font-body text-body text-bone whitespace-pre-wrap leading-relaxed">{value}</pre>
      </Panel>
    ))}
  </div>

  <PasHlavicka nazev="Tabu" hlas linka />
  <ul class="space-y-2.5 max-w-2xl">
    {voice.taboo.map((t) => (
      <li class="flex gap-3 text-body-lg text-bone/85">
        <span class="text-blood text-h3 leading-none shrink-0">✗</span>
        <span>{t}</span>
      </li>
    ))}
  </ul>

</Layout>
