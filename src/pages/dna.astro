---
import Layout from '../components/Layout.astro';
import { isHQ } from '../buildMode';
import { skryvatVeVerejnem } from '../data/sekce';
if (!isHQ && skryvatVeVerejnem(Astro.url.pathname)) return Astro.redirect('/');
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Karta from '../components/Karta.astro';
import Panel from '../components/Panel.astro';
import content from '../data/content.json';
---
<Layout title="Brand DNA">
  <SectionTitle
    title="Personality, hodnoty, archetypy"
    subtitle="Kdo je eldee jako značka. Pravidla pro chování, hlas, rozhodování."
  />

  <PasHlavicka nazev="Personality" hlas prvni />
  <div class="grid md:grid-cols-2 gap-5">
    {content.dna.personality.map((p) => (
      <Karta nadpis={p.trait} hrana="blood">{p.description}</Karta>
    ))}
  </div>

  <PasHlavicka nazev="Hodnoty" hlas linka />
  <div class="grid md:grid-cols-2 gap-5">
    {content.dna.values.map((v) => (
      <Karta nadpis={v.value} hrana="gold">{v.description}</Karta>
    ))}
  </div>

  <PasHlavicka
    nazev="Archetypy"
    hlas
    linka
    popis="Jungian brand archetypy — pomáhají rozhodovat se v hraničních případech (campaign, content, sponsorship)."
  />
  <div class="grid md:grid-cols-3 gap-5">
    {content.dna.archetypes.map((a) => (
      <Karta
        nadpis={a.name}
        hrana={a.primary ? 'blood' : 'zadna'}
        stitek={a.primary ? 'PRIMARY' : undefined}
      >
        {a.description}
      </Karta>
    ))}
  </div>

  <!-- Rebel vs. patřičnost: bez tohohle panelu si brand book protiřečí -->
  <PasHlavicka nazev={content.dna.napeti.nadpis} hlas linka />
  <Panel>
    <p class="text-body-lg text-bone/85 max-w-3xl">{content.dna.napeti.text}</p>
    <!-- Pointa celé sekce, ne doraz pásu — proto drží hlas značky
         (display italic zlatá), a ne 17px jako běžný Doraz. -->
    <p class="font-display text-h3 italic text-gold mt-5">{content.dna.napeti.veta}</p>
  </Panel>

</Layout>
