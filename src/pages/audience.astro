---
import Layout from '../components/Layout.astro';
import { isHQ } from '../buildMode';
import { skryvatVeVerejnem } from '../data/sekce';
if (!isHQ && skryvatVeVerejnem(Astro.url.pathname)) return Astro.redirect('/');
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Karta from '../components/Karta.astro';
import content from '../data/content.json';

// Parametry persony se staví z dat, ne ručně v šabloně: primární persona má
// věk a příjem, sekundární typ a rozhodovatele. Dřív to řešilo pět podmínek
// vepsaných do značek a prázdné pole `age` po sobě nechávalo mezeru.
type Persona = (typeof content.audience)['primary' | 'secondary'] & Record<string, unknown>;

function parametry(p: Persona) {
  return [
    ['VĚK', p.age],
    ['TYP', p.type],
    ['GEOGRAFIE', p.geography],
    ['PŘÍJEM', p.income],
    ['DECISION MAKER', p.decisionMaker],
  ].filter(([, v]) => typeof v === 'string' && v.trim() !== '') as [string, string][];
}

const personas = [
  { key: 'primary',   p: content.audience.primary   as Persona, label: 'PRIMARY · B2C' },
  { key: 'secondary', p: content.audience.secondary as Persona, label: 'SECONDARY · B2B' },
];
---
<Layout title="Target Audience">
  <SectionTitle
    title="Kdo nosí eldee"
    subtitle="Dvě cílovky — primárně mladí fotbalisti, sekundárně amatérské kluby."
  />

  {personas.map(({ key, p, label }, i) => (
    <section id={key}>
      <PasHlavicka nazev={p.name} hlas prvni={i === 0} linka={i > 0} meta={[label]} />

      <dl class="grid sm:grid-cols-[10rem_1fr] gap-x-8 gap-y-3 mb-9">
        {parametry(p).map(([k, v]) => (
          <>
            <dt class="font-mono text-caption text-gold sm:text-right">{k}</dt>
            <dd class="text-body text-bone">{v}</dd>
          </>
        ))}
      </dl>

      <div class="font-mono text-caption text-gold mb-3">LIFESTYLE</div>
      <ul class="text-body text-bone/80 space-y-1.5 max-w-2xl">
        {p.lifestyle.map((l) => (
          <li class="flex gap-2.5">
            <span class="text-bone/30 shrink-0">·</span>
            <span>{l}</span>
          </li>
        ))}
      </ul>

      <div class="grid md:grid-cols-2 gap-5 mt-8">
        <Karta nadpis="Pain" hrana="blood">{p.pain}</Karta>
        <Karta nadpis="Motivation" hrana="gold">{p.motivation}</Karta>
      </div>
    </section>
  ))}
</Layout>
