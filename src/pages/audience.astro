---
import Layout from '../components/Layout.astro';
import { isHQ } from '../buildMode';
import { skryvatVeVerejnem } from '../data/sekce';
if (!isHQ && skryvatVeVerejnem(Astro.url.pathname)) return Astro.redirect('/');
import SectionTitle from '../components/SectionTitle.astro';
import PasHlavicka from '../components/PasHlavicka.astro';
import Karta from '../components/Karta.astro';
import content from '../data/content.json';

// Persony se čtou z pole, ne ze dvou pevných klíčů primary/secondary
// (revize 22. 9. 2026). Jedna persona na 10–19 let neunesla rozdíl mezi žákem,
// za kterého platí rodič, a dorostencem, který rozhoduje i platí sám — a rodič
// v sekci nebyl vůbec, přestože je to on, kdo řekne ne.
type Persona = (typeof content.audience.personas)[number] & Record<string, unknown>;

function parametry(p: Persona) {
  return [
    ['VĚK', p.age],
    ['TYP', p.type],
    ['ROLE V NÁKUPU', p.role],
    ['KDE', p.geography],
    ['PENÍZE', p.income],
    ['ROZHODUJE', p.decisionMaker],
  ].filter(([, v]) => typeof v === 'string' && v.trim() !== '') as [string, string][];
}
---
<Layout title="Pro koho">
  <SectionTitle
    title="Kdo nosí eldee"
    subtitle="Tři lidé kolem jednoho nákupu — a klub jako druhá cesta."
  />

  {content.audience.personas.map((p, i) => (
    <section id={p.key}>
      <PasHlavicka nazev={p.name} hlas prvni={i === 0} linka={i > 0} meta={[p.label]} />

      <dl class="grid sm:grid-cols-[11rem_1fr] gap-x-8 gap-y-3 mb-9">
        {parametry(p as Persona).map(([k, v]) => (
          <>
            <dt class="font-mono text-caption text-gold sm:text-right">{k}</dt>
            <dd class="text-body text-bone">{v}</dd>
          </>
        ))}
      </dl>

      <div class="font-mono text-caption text-gold mb-3">JAK ŽIJE</div>
      <ul class="text-body text-bone/80 space-y-1.5 max-w-2xl">
        {p.lifestyle.map((l) => (
          <li class="flex gap-2.5">
            <span class="text-bone/30 shrink-0">·</span>
            <span>{l}</span>
          </li>
        ))}
      </ul>

      <div class="grid md:grid-cols-2 gap-5 mt-8">
        <Karta nadpis="Bolest" hrana="blood">{p.pain}</Karta>
        <Karta nadpis="Motivace" hrana="gold">{p.motivation}</Karta>
      </div>
    </section>
  ))}

  <!-- Anti-persona: sekce 01 má „Co eldee není“, tady chyběl protějšek.
       Bez něj se cílovka rozteče — každý další nápad se dá obhájit tím,
       že „to je taky mladý kluk“. Doplněno 22. 9. 2026. -->
  <PasHlavicka nazev={content.audience.neni.nadpis} hlas linka />
  <ul class="text-body-lg text-bone/85 space-y-3 max-w-3xl">
    {content.audience.neni.body.map((b) => (
      <li class="flex gap-3">
        <span class="text-blood text-h3 leading-none shrink-0">✗</span>
        <span>{b}</span>
      </li>
      ))}
  </ul>
</Layout>
