---
// Karta pravidla (B2). Nahrazuje šedý drobný text pod obrázky, který Lukáš
// označil za přehlédnutelný: barevná hrana + štítek typu + 15px skoro bílá.
interface Props {
  typ: 'ok' | 'ne' | 'rozmer';
}
const { typ } = Astro.props;

const STYL = {
  ok:     { stitek: '✓ Pravidlo', hrana: 'border-[#10B981]', barva: 'text-[#10B981]' },
  ne:     { stitek: '✕ Nikdy',    hrana: 'border-blood',     barva: 'text-blood' },
  rozmer: { stitek: 'Rozměr',     hrana: 'border-gold',      barva: 'text-gold' },
} as const;

const { stitek, hrana, barva } = STYL[typ];
---
<div class={`border-l-[3px] ${hrana} pl-4 py-2.5`}>
  <span class={`block font-mono text-[9.5px] tracking-[0.18em] font-bold uppercase mb-1.5 ${barva}`}>{stitek}</span>
  <p class="text-[15px] leading-[1.5] text-bone/88"><slot /></p>
</div>
