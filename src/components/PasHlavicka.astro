---
// Hlavička pásu uvnitř sekce (B2): název vlevo, technická data vpravo.
// Rozměr a adresa patří k ukázce, ne do odstavce pod ní — když je čte oko
// v jednom řádku s nadpisem, nemusí se pro ně nikam vracet.
interface Props {
  nazev: string;
  /** Řádky technických dat vpravo (rozměr, doména, kadence). */
  meta?: string[];
  /** První pás v sekci nemá nad sebou co odsadit. */
  prvni?: boolean;
}
const { nazev, meta = [], prvni = false } = Astro.props;
---
<!-- Na telefonu pod sebou: vedle nadpisu se delší technický popisek nevejde
     a vytlačil by stránku ze šířky obrazovky (naměřeno na 390 px). -->
<div class={`flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6 mb-4 ${prvni ? 'mt-0' : 'mt-14 sm:mt-16'}`}>
  <h2 class="font-display text-h2 text-bone">{nazev}</h2>
  {meta.length > 0 && (
    <div class="font-mono text-caption text-bone/45 leading-[1.9] sm:text-right min-w-0">
      {meta.map((r) => <div class="break-words">{r}</div>)}
    </div>
  )}
</div>
