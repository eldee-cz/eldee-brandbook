---
import { isHQ } from '../buildMode';
import { najdiSekci, stitekSekce } from '../data/sekce';

interface Props {
  title: string;
  subtitle?: string;
  /** Ruční štítek pro podstránky, které nejsou samostatnou sekcí (např. /logo/construction). */
  stitek?: string;
}

const { title, subtitle, stitek } = Astro.props;

// Číslo ani blok se nepředávají ručně — hlavička si je najde podle cesty,
// takže se nemůžou rozejít se sidebarem ani s obsahem.
const sekce = najdiSekci(Astro.url.pathname, isHQ);
const popisek = stitek ?? (sekce ? stitekSekce(sekce) : '');
---
<header class="mb-14">
  {popisek && (
    <div class="flex items-center gap-4 mb-5">
      <div class="w-1.5 h-8 bg-blood shrink-0"></div>
      <div class="font-mono text-caption text-gold">{popisek}</div>
    </div>
  )}
  <h1 class="font-display text-h1 italic text-bone">{title}</h1>
  {subtitle && <p class="text-body-lg text-bone/70 mt-4 max-w-2xl">{subtitle}</p>}
</header>
