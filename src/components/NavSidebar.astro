---
// Navigace ve dvou podobách ze stejného seznamu:
//   monitor (lg+) — boční menu vlevo, jako dosud
//   telefon       — lišta nahoře s velkým tlačítkem „Sekce“, panel přes celou šířku
//
// Proč vůbec: do 11. 9. mělo menu natvrdo 256 px a shrink-0 bez mobilní
// varianty. Na displeji 390 px začínal obsah až na souřadnici 256, takže
// se stránka četla z poloviny mimo obrazovku — na všech stránkách knihy.
// Projekt má přitom 95 % návštěv z mobilu.
//
// Panel je <details>, ne skript: funguje bez JS, umí ho klávesnice i odečítač
// a po prokliku se stránka načte znovu, takže se zavře sám.
// Pravidlo projektu „nehidovat navigaci pod malý hamburger“ drží popsané
// tlačítko 48 px vysoké, ne ikonka.
import { isHQ } from '../buildMode';
import { VERZE } from '../data/sekce';
import NavSeznam from './NavSeznam.astro';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const label = isHQ ? `BRAND BOOK · ${VERZE}` : 'LOGOMANUAL';
---

<!-- ── Telefon a tablet ──────────────────────────────────────────────────── -->
<details class="lg:hidden sticky top-0 z-50 bg-ink/95 backdrop-blur border-b border-bone/10 print:hidden group">
  <summary class="flex items-center justify-between gap-4 px-5 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
    <a href="/" class="block min-w-0">
      <img src="/logo/wordmark-light.svg" alt="eldee" class="block h-8 w-auto" />
      <div class="font-mono text-caption text-bone/50 mt-1 truncate">{label}</div>
    </a>
    <span data-tlacitko="sekce" class="flex items-center gap-2.5 shrink-0 min-h-[48px] px-5 rounded border border-bone/25 text-bone">
      <span class="font-mono text-caption">SEKCE</span>
      <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" viewBox="0 0 12 8" fill="none" aria-hidden="true">
        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </summary>
  <nav aria-label="Sekce brand booku" class="px-3 pt-2 pb-6 max-h-[70vh] overflow-y-auto border-t border-bone/10">
    <NavSeznam velke aktualni={currentPath} />
  </nav>
</details>

<!-- ── Monitor ───────────────────────────────────────────────────────────── -->
<nav
  aria-label="Sekce brand booku"
  class="hidden lg:block w-64 shrink-0 border-r border-ink/40 bg-ink/95 p-6 sticky top-0 h-screen overflow-y-auto print:hidden"
>
  <a href="/" class="block mb-6">
    <img src="/logo/wordmark-light.svg" alt="eldee" class="block h-11 w-auto mb-2" />
    <div class="font-mono text-caption text-bone/50">{label}</div>
  </a>
  <NavSeznam aktualni={currentPath} />
</nav>
