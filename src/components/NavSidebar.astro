---
import { isHQ } from '../buildMode';
import { BLOKY, VERZE, sekceProBuild, type BlokId } from '../data/sekce';

const sekce = sekceProBuild(isHQ);

// Seskupení podle bloků, aby bylo na první pohled vidět, kde v knize jsi.
const poradiBloku: BlokId[] = ['I', 'II', 'III'];
const skupiny = poradiBloku
  .map((id) => ({ blok: BLOKY[id], polozky: sekce.filter((s) => s.blok === id) }))
  .filter((g) => g.polozky.length > 0);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const label = isHQ ? `BRAND BOOK · ${VERZE}` : 'LOGOMANUAL';
---
<nav aria-label="eldee sections" class="w-64 shrink-0 border-r border-ink/40 bg-ink/95 p-6 sticky top-0 h-screen overflow-y-auto print:hidden">
  <a href="/" class="block mb-8">
    <div class="font-display text-h2 italic text-bone">eldee</div>
    <div class="font-mono text-caption text-bone/50">{label}</div>
  </a>

  {skupiny.map((g, gi) => (
    <div class:list={['mb-6', gi > 0 && 'pt-5 border-t border-bone/10']}>
      <div class="font-mono text-caption text-bone/35 px-3 mb-2">
        {isHQ ? `BLOK ${g.blok.id} · ${g.blok.nazev.toUpperCase()}` : g.blok.nazev.toUpperCase()}
      </div>
      <ul class="space-y-1">
        {g.polozky.map((s) => {
          const isActive = currentPath === s.href.replace(/\/$/, '');
          return (
            <li>
              <a
                href={s.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'flex items-baseline gap-3 px-3 py-2 rounded text-body transition',
                  isActive
                    ? 'bg-blood/20 text-bone'
                    : 'text-bone/60 hover:text-bone hover:bg-bone/5',
                ]}
              >
                <span class="font-mono text-caption text-gold w-6 shrink-0">{s.cislo}</span>
                <span>{s.nazev}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>
