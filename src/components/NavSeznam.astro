---
// Seznam sekcí seskupený po blocích. Žije na jednom místě, protože ho
// potřebuje boční menu na monitoru i vysouvací panel na telefonu — a dvě
// kopie seznamu už se v téhle knize jednou rozešly (viz sekce.ts).
import { isHQ } from '../buildMode';
import { blokyProBuild, sekceProBuild } from '../data/sekce';

interface Props {
  /** Velké dotykové cíle pro telefon (min. 48 px na řádek). */
  velke?: boolean;
  /** Cesta aktuální stránky — pro zvýraznění. */
  aktualni: string;
}
const { velke = false, aktualni } = Astro.props;

const sekce = sekceProBuild(isHQ);
const skupiny = blokyProBuild(isHQ)
  .map((blok) => ({ blok, polozky: sekce.filter((s) => s.blok === blok.id) }))
  .filter((g) => g.polozky.length > 0);

// `/`.replace(/\/$/, '') je prázdný řetězec, kdežto aktuální cesta se
// normalizuje na `/` — sekce 01 se proto v menu nikdy neoznačila jako
// otevřená. Obě strany musí projít stejnou normalizací.
const norm = (h: string) => h.replace(/\/$/, '') || '/';

const radek = velke
  ? 'flex items-baseline gap-4 px-4 min-h-[48px] py-3 rounded text-body-lg'
  : 'flex items-baseline gap-3 px-3 py-1.5 rounded text-body leading-tight transition';
---
{skupiny.map((g, gi) => (
  <div class:list={[velke ? 'mb-7' : 'mb-4', gi > 0 && (velke ? 'pt-6 border-t border-bone/10' : 'pt-4 border-t border-bone/10')]}>
    {/* Hlavička bloku vede na jeho předěl — jinak by byla předělová stránka
        dostupná jen tím, že na ni člověk narazí při listování. */}
    <a
      href={g.blok.href}
      aria-current={aktualni === norm(g.blok.href) ? 'page' : undefined}
      class:list={[
        'block font-mono text-caption rounded transition',
        velke ? 'px-4 py-3 min-h-[44px] flex items-center mb-1' : 'px-3 py-1.5 mb-1',
        aktualni === norm(g.blok.href)
          ? 'bg-blood/20 text-bone'
          : 'text-bone/35 hover:text-bone hover:bg-bone/5',
      ]}
    >
      {isHQ ? `BLOK ${g.blok.id} · ${g.blok.nazev.toUpperCase()}` : g.blok.nazev.toUpperCase()}
    </a>
    <ul class={velke ? 'space-y-1.5' : 'space-y-0.5'}>
      {g.polozky.map((s) => {
        const isActive = aktualni === norm(s.href);
        return (
          <li>
            <a
              href={s.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                radek,
                isActive ? 'bg-blood/20 text-bone' : 'text-bone/60 hover:text-bone hover:bg-bone/5',
              ]}
            >
              <span class:list={['font-mono text-caption text-gold shrink-0', velke ? 'w-7' : 'w-6']}>{s.cislo}</span>
              <span>{s.nazev}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
))}
